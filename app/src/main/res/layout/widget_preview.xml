<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows before the widget is placed: a sample week
     with made-up events, never the household's own (Android 12+). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wp_bg_card"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Monday" android:textColor="@color/wp_muted" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="October 19" android:textColor="@color/wp_ink" android:textSize="22sp" />
        </LinearLayout>
        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="8dp" android:background="@drawable/wp_bg_chip">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_widget_refresh" android:tint="@color/wp_chip_icon" />
        </FrameLayout>
        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/wp_bg_accent">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_widget_plus" android:tint="@color/wp_on_accent" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="7dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mon" android:textColor="@color/wp_accent" android:textSize="12sp" />
            <TextView android:layout_width="30dp" android:layout_height="30dp" android:gravity="center" android:background="@drawable/wp_bg_today" android:text="19" android:textColor="@color/wp_on_accent" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginBottom="5dp" android:background="@drawable/wp_bg_task" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="10dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="8dp" android:src="@drawable/ic_widget_box" android:tint="@color/wp_on_accent" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="Pick up groceries" android:textColor="@color/wp_on_accent" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:background="@drawable/wp_bg_ev_blue" android:orientation="vertical" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="Dentist" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="3:30 – 4:15 PM" android:textColor="#FFFFFFFF" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:background="@drawable/wp_bg_ev_orange" android:orientation="vertical" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="Soccer practice" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="6:00 – 7:15 PM" android:textColor="#FFFFFFFF" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="7dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tue" android:textColor="@color/wp_muted" android:textSize="12sp" />
            <TextView android:layout_width="30dp" android:layout_height="30dp" android:gravity="center" android:text="20" android:textColor="@color/wp_ink" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:background="@drawable/wp_bg_ev_purple" android:orientation="vertical" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="Piano lesson" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="4:00 – 4:45 PM" android:textColor="#FFFFFFFF" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="7dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thu" android:textColor="@color/wp_muted" android:textSize="12sp" />
            <TextView android:layout_width="30dp" android:layout_height="30dp" android:gravity="center" android:text="22" android:textColor="@color/wp_ink" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:background="@drawable/wp_bg_ev_green" android:orientation="vertical" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="Book club" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="7:00 – 8:30 PM" android:textColor="#FFFFFFFF" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
